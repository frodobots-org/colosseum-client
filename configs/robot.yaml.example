# Copy to robot.yaml and fill in your Client Token and its bound Institution.
router_url: wss://191.222.219.43
token: clt_replace_with_token_from_router_ui
institution: test # Must match the Institution bound to this token

robot_type: franka # franka | so101 | yam | g1; selects the robot implementation
# SO101, YAM and G1 are TODOs: real mode requires implementing their drivers first.
test: true # true = dummy data; false = real robot data
policy_server_url: ws://localhost:8000 # Local Policy Server; null = remote inference
track: 1 # 1 = Open, 2 = Fine-tuning
scene: office
evaluator: local-tester

# Leave empty to enter the prompt at startup (Open) or select a task (Fine-tuning).
instruction: ""
recording: true # Save LeRobot locally
skip_upload: false # true = skip automatic dataset upload; keep local files for manual upload later
max_trial_steps: 3 # Open Track limit; Fine-tuning uses the Router task limit
prepare_timeout: 1800 # Model download, loading and warm-up timeout in seconds
deadline_ms: 30000 # Per-request inference timeout in milliseconds

# Dummy data needs no physical cameras.
# For real hardware, set test: false and configure the cameras your driver uses:
# cameras:
#   left_image: "YOUR_LEFT_CAMERA_ID"
#   right_image: "YOUR_RIGHT_CAMERA_ID"
#   head_image: "YOUR_HEAD_CAMERA_ID"
cameras: {}

# Optional settings:
# control_hz: 15 # Must match the real robot controller and assigned model
# api_url: "" # Derived from router_url when empty
# evaluation_dir: eval_runs
# Optional direct upload to your PUBLIC dataset (install the selected SDK extra):
# ModelScope: `uv sync --extra modelscope` plus Git; Hugging Face: `uv sync --extra huggingface`
# dataset_url: https://modelscope.cn/datasets/YOUR_ACCOUNT/YOUR_DATASET
# Or dataset_url: https://huggingface.co/datasets/YOUR_ACCOUNT/YOUR_DATASET
# dataset_token: YOUR_WRITE_TOKEN_FOR_THE_SELECTED_PLATFORM
# Alternatively omit dataset_token and set DATASET_TOKEN (or MODELSCOPE_API_TOKEN / HF_TOKEN),
# or use dataset_token_file (relative to this YAML file). Credentials stay on Client.
# dataset_token_file: secrets/dataset-token
# adapter_config: {} # Adapter-specific connection/calibration settings

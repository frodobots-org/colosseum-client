url: wss://router.example.com:8443
token: clt_replace_with_token_from_router_ui

# These IDs are the physical camera serial numbers found in RobotEnv image keys.
cameras:
  left_image: "24259877"
  right_image: "24514023"
  head_image: "13062452"

# Leave empty to enter the instruction when the program starts.
instruction: ""

# Evaluation station identity. The implemented hardware adapter is DROID/Franka.
robot_type: franka
adapter: droid
# Empty derives HTTPS/HTTP from the WSS/WS URL on the same port.
api_url: ""
evaluation_dir: eval_runs
# Open Track limit; Fine-tuning limits come from the server task protocol.
max_trial_steps: 2700

# Per-request inference timeout, including the first request during model warm-up.
deadline_ms: 30000
